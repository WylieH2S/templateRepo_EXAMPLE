#CHLOEAI:1
TYPE="path_rules"
GLOB="src/**, lib/**"

PURPOSE:
Rules active when touching source code files. Loaded on demand — not every session.
Fill in for your project. Delete sections that don't apply.

---

LANGUAGE_RUNTIME:
; e.g., "Python 3.12.x only; no 3.11 support. uv-managed venv at .venv/"
; e.g., "Node 20 LTS. pnpm only — do not use npm or yarn."
- (fill in)

BUILD:
; e.g., "make build" / "cargo build --release" / "no build step"
- (fill in)

STYLE_CONVENTIONS:
; e.g., "snake_case functions, PascalCase classes, no abbreviations in names"
; e.g., "max 80 chars per line; no trailing whitespace"
- (fill in)

FORBIDDEN_PATTERNS:
; Things that must NOT appear in code regardless of task scope.
; e.g., "no print() in production paths — use the logger"
; e.g., "no hardcoded secrets or API keys in any file"
- (fill in)

EXPLICITLY_NOT_TOUCHING:
; Files or modules that are off-limits unless CURRENT_MISSION.md says otherwise.
- (fill in)
