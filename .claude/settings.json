{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "SessionStart gate pair (HI Mode). handoff-gate.sh = model/effort vs the latest HANDOFF recommendation; wrap-gate.sh = prior-session unwrapped/unpushed/uncommitted. Both are advisory (always exit 0). If a repo already has a settings.json, MERGE these hooks in rather than overwrite.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/handoff-gate.sh" },
          { "type": "command", "command": "bash .claude/hooks/wrap-gate.sh" }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/handoff-gate.sh" },
          { "type": "command", "command": "bash .claude/hooks/wrap-gate.sh" }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/handoff-gate.sh" },
          { "type": "command", "command": "bash .claude/hooks/wrap-gate.sh" }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/handoff-gate.sh" },
          { "type": "command", "command": "bash .claude/hooks/wrap-gate.sh" }
        ]
      }
    ]
  }
}
