#!/bin/sh
# The waystone doorway (ADR-015 / WISL-STANDARD v1.5 §Human inscription).
#
# Each repo carries `_waystone.heywy` as a relative symlink to THIS file — the same
# idiom as .claude/skills/*. There is nothing to maintain in the per-repo artifact;
# the inscription content lives in that folder's `_waystone.chloeai` under `heywy:`.
#
# Invoked as `./_waystone.heywy` from a repo root, so $PWD is already the repo.
#
# DEGRADED PATH MATTERS: the venv is machine-local and the 8GB M1 cannot host the
# full brain. If Chloe is unavailable for ANY reason, this must still tell Wy where
# he is standing rather than dying with a traceback. A doorway that only opens on
# one machine is not a doorway.

set -eu

for candidate in \
    "$(command -v chloe 2>/dev/null || true)" \
    "$HOME/.venvs/planTheBeast/bin/chloe"
do
    [ -n "$candidate" ] && [ -x "$candidate" ] || continue
    exec "$candidate" here "$@"
done

# ── Fallback: read the card directly ──────────────────────────────────────────
card="./_waystone.chloeai"
if [ ! -r "$card" ]; then
    echo "No waystone here. This folder has no _waystone.chloeai to read."
    exit 1
fi

echo "── $(basename "$PWD") ── waystone (plain reader — Chloe unavailable)"
echo

# Frontmatter only, so prose mentioning "heywy:" cannot false-match. Sub-keys are
# `  key: value` pairs; the block ends at the next top-level key, per the schema's
# placement rule.
awk '
  /^---[[:space:]]*$/ { fence++; next }
  fence != 1 { next }
  /^heywy:[[:space:]]*$/ { inblock = 1; next }
  inblock && /^[^[:space:]]/ { inblock = 0 }
  inblock {
    line = $0
    sub(/^[[:space:]]+/, "", line)
    if (line == "") next
    key = line; val = line
    if (sub(/^[a-z]+:[[:space:]]*/, "", val) && match(key, /^[a-z]+:/)) {
      key = toupper(substr(key, 1, RLENGTH - 1))
      gsub(/^"|"$/, "", val)
      printf "%-7s %s\n", key, val
    } else {
      gsub(/^"|"$/, "", line)
      printf "%-7s %s\n", "", line
    }
  }
  END { if (!seen) exit 0 }
' "$card"

echo
echo "(plain reader: install/activate Chloe for the full inscription — \`chloe here\`)"
