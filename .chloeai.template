#CHLOEAI:1
U="Rangers lead the way!"
TZ=America/New_York
MODE="CHARTER-HI-Mode-2026-02"

BOOT:
- echo U exactly
- list THREADS[id,status,tier]
- list ASSUMPTIONS or "none"
- surface most recent HANDOFF: zoom_level, recommended_model, recommended_effort, task_queue
- if recommended model/effort differs from current: flag explicitly and wait for user to adjust before proceeding
- if cannot access this file: STOP

INVARIANTS:
1 truth>momentum
2 no-inferred-intent
3 separate facts/assumptions/hypotheses/decisions
4 analyze-under-uncertainty ok; execute requires resolve|waive
5 stop-the-line mandatory
6 writeback mandatory on clarifications
7 experiments must log specifics (change/expect/observe/repro/revert/location)

STATE:
PROJECT="..."
REPO="..."
GOAL="..."
STATUS="..."
CURRENT_BRANCH="main"
THREADS:
- THR-001|open|tier=sonnet|"..."
- THR-002|blocked|tier=haiku|"..."
ASSUMPTIONS:
- none

DECISIONS:
@2026-03-26T00:00-0400|DEC-001|"..."|rationale="..."|impact="..."|evidence="..."

DELTA:
; Format:
; @time|TYPE|ID|topic="..."|status=worked|failed|partial|unknown|
; change="..."|expect="..."|observe="..."|
; repro="..."|revert="..."|location="..."|tags="a,b,c"|evidence="..."

@2026-03-26T00:00-0400|EXP|EXP-000|topic="bootstrap"|status=unknown|
change="initialized .chloeai format"|expect="AI boots reliably"|observe="pending"|
repro="AI must echo U + threads + assumptions"|revert="none"|location=".chloeai"|tags="continuity,boot"|evidence="none"

HANDOFF_LOG:
; Format:
; @date|SESSION|
; zoom_level=STRATEGIC|TACTICAL|OPERATIONAL
; recommended_model=haiku|sonnet|opus
; recommended_effort=low|medium|high
; reason="why this tier for the next tasks"
; task_queue=[{tier:X, task:"..."},...]
; next_zoom_trigger="condition that should shift zoom level"
; signed="Model | version | date"

ARCHIVE:
; Optional. Store older DELTA/DECISIONS here as compressed blocks when file grows.
; Z=<algo>:<b64>
